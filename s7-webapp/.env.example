# Firebase web configuration for the contact form.
#
# These are *web* keys: they identify the project and are visible in any
# Firebase web app. They grant nothing on their own — firestore.rules is what
# protects the data. Copy this file to `.env` and fill in the API key from
# Firebase console → Project settings → General → Your apps → Web app.
#
# Without VITE_FIREBASE_API_KEY the contact form still works: it falls back to
# opening a pre-filled email instead of storing the message.

VITE_FIREBASE_PROJECT_ID=service7-8bd8b
VITE_FIREBASE_API_KEY=
