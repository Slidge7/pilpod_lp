rules_version = '2';

/**
 * S7 — Firestore rules.
 *
 * The contact form writes straight to Firestore from the browser, so these
 * rules are the only thing standing between the collection and the internet.
 * They are written as a whitelist: a document may be created if it is exactly
 * the shape the form sends, and nothing may ever be read, changed or deleted
 * by a client. Messages are read in the Firebase console or by a server using
 * the Admin SDK, both of which bypass these rules.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules functions must live inside the service block — one declared at the
    // top level of the file does not compile.
    function isWellFormedMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'company', 'topic', 'message', 'lang', 'createdAt'])
          && d.keys().hasAll(['name', 'email', 'message', 'createdAt'])
          && d.name is string     && d.name.size() > 0      && d.name.size() <= 120
          && d.email is string    && d.email.size() > 3     && d.email.size() <= 180
          && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
          && d.message is string  && d.message.size() >= 20 && d.message.size() <= 4000
          && (!('company' in d) || (d.company is string && d.company.size() <= 120))
          && (!('topic' in d)   || (d.topic is string   && d.topic.size() <= 80))
          && (!('lang' in d)    || (d.lang is string    && d.lang.size() <= 8))
          && d.createdAt is timestamp
          // Reject a clock that is wildly out, which is a sign of a replayed write.
          && d.createdAt < request.time + duration.value(5, 'm')
          && d.createdAt > request.time - duration.value(1, 'h');
    }

    match /messages/{messageId} {
      allow create: if isWellFormedMessage();
      allow read, update, delete: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
